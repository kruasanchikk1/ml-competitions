# Скопируйте в .env и заполните перед запуском docker compose up

# --- Эмбеддинги / реранкинг (ingestion, retrieval) ---
# hash   — офлайн-заглушка для разработки/CI без интернета (по умолчанию)
# bge-m3 — BAAI/bge-m3, локальная мультиязычная модель (~2.2 ГБ, качается при первом запуске)
# qwen3  — Qwen/Qwen3-Embedding-0.6B, альтернатива для side-by-side сравнения
EMBEDDING_BACKEND=hash
RERANK_BACKEND=hash

QDRANT_URL=http://localhost:6333

# --- LLM для генерации ответа в Langflow (любой OpenAI-совместимый эндпоинт) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Langfuse (трейсинг, версионирование промптов, метрики) ---
# Получить публичный/секретный ключ: https://cloud.langfuse.com -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
